# Copy this file to `.env` (or export these in your shell/web-server env).
# NOTE: the app reads real environment variables directly via getenv() —
# there is no .env parser bundled, so use:  export DB_PASSWORD=...  or
# set these in your Apache/Nginx/PHP-FPM environment instead.

# --- Application -----------------------------------------------------------
APP_ENV=production            # development | production
APP_DEBUG=false               # true shows detailed error pages
APP_URL=http://localhost/salon

# --- Database --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nirav_hairstorm
DB_USERNAME=root
DB_PASSWORD=

# Auto-created admin account (used only when the app auto-installs an empty DB)
# DB_ADMIN_EMAIL=admin@salon.local
# DB_ADMIN_PASSWORD=admin123

# --- Optional overrides (see config/config.php for defaults) --------------
# APP_TIMEZONE=Asia/Kolkata
# SESSION_NAME=nhs_session
# SESSION_LIFETIME=7200
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_HTTPONLY=true
